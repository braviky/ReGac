{
  "train_batch_size": 64,
  "per_device_train_batch_size": 16,
  "gradient_accumulation_steps": 1,

  "optimizer": {
    "type": "Adam",
    "params": {
      "lr": 2.0e-4,
      "betas": [0.9, 0.999],
      "eps": 1.0e-8,
      "weight_decay": 0.0
    }
  },

  "zero_optimization": {
        "stage": 2,
        "offload_optimizer": {
            "device": "cpu",
            "pin_memory": true
        },
        "offload_param": {
            "device": "cpu",
            "pin_memory": true
        },
        "allgather_partitions": true,
        "allgather_bucket_size": 2e8,
        "overlap_comm": true,
        "reduce_scatter": true,
        "reduce_bucket_size": 2e8,
        "contiguous_gradients": true
    },

  "fp16": {
    "enabled": false,
    "loss_scale": 0,
    "initial_scale_power": 15
  },

  "gradient_clipping": 100.0,
  "wall_clock_breakdown": false,

  "monitor": {
    "tensorboard": {
      "enabled": true,
      "output_path": null,
      "gradient_norm": {
        "enabled": true,
        "tag": "global_grad_norm"
      }
    },
    "wandb": {
      "enabled": false
    },
    "csv_monitor": {
      "enabled": false
    }
  },

  "activation_checkpointing": {
    "partition_activations": true,
    "cpu_checkpointing": true
}
}